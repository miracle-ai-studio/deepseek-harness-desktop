{
  "name": "@deepseek-ai/dsh-macos-surface",
  "description": "Cordis adapter that attaches DeepSeek Harness Desktop to the existing Web Host",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
